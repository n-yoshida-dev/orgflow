Project orgflow {
  database_type: 'PostgreSQL'
}

Table tenants {
  id uuid [pk]
  name varchar(100) [not null, unique]
}

Table users {
  id uuid [pk]
  display_name varchar(100) [not null]
  login_id varchar(100) [not null, unique]
  hashed_password text [not null]
  mail_address text [not null, unique]
  created_at timestamptz [not null, default: `now()`]
}

Table tenant_memberships {
  id uuid [pk]
  tenant_id uuid [not null, ref: > tenants.id]
  user_id uuid [not null, ref: > users.id]
  indexes {
  (id, tenant_id) [unique]
  (tenant_id, user_id) [unique]
  }
}

Table tenant_roles {
  id uuid [pk]
  name varchar(100) [not null, unique]
}

Table tenant_membership_roles {
  id uuid [pk]
  tenant_membership_id uuid [not null, ref: > tenant_memberships.id]
  tenant_role_id uuid [not null, ref: > tenant_roles.id]
  indexes {
  (tenant_membership_id, tenant_role_id) [unique]
  }
}

Table internal_organizations {
  id uuid [pk]
  tenant_id uuid [not null, ref: > tenants.id]
  internal_organization_name text [not null]
  indexes {
  (id, tenant_id) [unique]
  (tenant_id, internal_organization_name) [unique]
  }
}

Table internal_organization_memberships {
  id uuid [pk]
  tenant_id uuid [not null, ref: > tenants.id]
  tenant_membership_id uuid [not null]
  internal_organization_id uuid [not null]
  indexes {
  (tenant_membership_id, internal_organization_id) [unique]
  }
}
Ref: internal_organization_memberships.(tenant_membership_id, tenant_id) > tenant_memberships.(id, tenant_id)
Ref: internal_organization_memberships.(internal_organization_id, tenant_id) > internal_organizations.(id, tenant_id)

Table roles {
  id uuid [pk]
  role_name text [not null, unique]
}

Table membership_roles {
  id uuid [pk]
  internal_organization_membership_id uuid [not null, ref: > internal_organization_memberships.id]
  role_id uuid [not null, ref: > roles.id]
  indexes {
    (role_id, internal_organization_membership_id) [unique]
  }
}

Enum request_status {
  draft
  in_progress
  approved
  returned
  rejected
  cancelled
}

Table requests {
  id uuid [pk]
  tenant_id uuid [not null, ref: > tenants.id]
  request_series_id uuid [not null, note: 'requestのバージョンを束ねるための親番号']
  version_no int [not null, check: `version_no >= 1`, note: '採番はアプリ側で行う']
  user_id uuid [not null, ref: > users.id, note: '自身の request の一覧表示の判定で使用']
  status request_status [not null]
  current_applied_approval_route_step_id uuid [null]
  applicant_user_id uuid [not null]
  internal_organization_id uuid [not null]
  request_type text [not null,check:
    `request_type IN (
      'transportation_expenses',
      'travel_expenses',
      'equipment_purchase_expenses'
    )`]
  amount int [not null, check: `amount >= 0`, note: "申請金額"]
  created_at timestamptz [not null, default: `now()`]
  indexes {
  	applicant_user_id
  	internal_organization_id
  	(internal_organization_id, status)
    (request_series_id, version_no) [unique]
  }
}
Ref: requests.(id, current_applied_approval_route_step_id) > applied_approval_route_steps.(request_id, id)
Ref: requests.(internal_organization_id, tenant_id) > internal_organizations.(id, tenant_id)
Ref: requests.(tenant_id, applicant_user_id) > tenant_memberships.(tenant_id, user_id)

Enum approval_type {
  approved
  returned
  rejected
}

Table approvals {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  request_id uuid [not null, ref: > requests.id]
  applied_approval_route_step_id uuid [not null, note:"どの承認段に対する承認か"]
  type approval_type [not null, note:"承認の種類は何か（承認 / 差し戻し / 却下）"]
  approval_message text [null]
  created_at timestamptz [not null]
  indexes {
    (request_id, applied_approval_route_step_id) [unique]
  }
}
Ref: approvals.(request_id, applied_approval_route_step_id) > applied_approval_route_steps.(request_id, id)

Table approval_policies {
  id uuid [pk]
  tenant_id uuid [not null, ref: > tenants.id]
  policy_name varchar(100) [not null, unique]
  internal_organization_id uuid [not null, ref: > internal_organizations.id]
  request_type text [not null,check:
    `request_type IN (
      'transportation_expenses',
      'travel_expenses',
      'equipment_purchase_expenses'
    )`]
  min_amount int [not null, note: "0の場合は金額条件なし"]
  approval_route_id uuid [not null, ref: > approval_routes.id]
  indexes {
  (tenant_id, policy_name) [unique]
  (tenant_id, internal_organization_id, request_type, min_amount) [unique]

  }
}

Table approval_routes {
  id uuid [pk]
  tenant_id uuid [not null, ref: > tenants.id]
  name varchar(100) [not null]
  indexes {
  (tenant_id, name) [unique]
  }
}

Table approval_route_steps {
  id uuid [pk]
  step_no int [not null]
  approval_route_id uuid [not null, ref: > approval_routes.id]
  indexes {
    (approval_route_id, step_no) [unique]
  }
}

Table approval_route_step_approvers {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  approval_route_step_id uuid [not null, ref: > approval_route_steps.id]
  indexes {
  (user_id, approval_route_step_id) [unique]
  }
}

Table applied_approval_routes {
  id uuid [pk]
  request_id uuid [not null, unique, ref: - requests.id]
  approval_policy_id uuid [not null, ref: > approval_policies.id]
  indexes {
  (id, request_id) [unique]
  }
}

Table applied_approval_route_steps {
  id uuid [pk]
  step_no int [not null]
  applied_approval_route_id uuid [not null]
  request_id uuid [not null, ref: > requests.id]
  indexes {
    (request_id, id) [unique]
    (applied_approval_route_id, step_no) [unique]
  }
}
Ref: applied_approval_route_steps.(applied_approval_route_id, request_id) > applied_approval_routes.(id, request_id)


Table applied_approval_route_step_approvers {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  applied_approval_route_step_id uuid [not null, ref: > applied_approval_route_steps.id]
  indexes {
  (user_id, applied_approval_route_step_id) [unique]
  }
}

Enum operation_type {
  create
  update
  delete
  submit
  approve
  return
  reject
  cancel
  login
  logout
}

Table audit_logs {
  id uuid [pk]
  actor_tenant_id uuid [not null, ref: > tenants.id]
  actor_user_id uuid [not null, ref: > users.id]
  actor_user_display_name text [not null]
  actor_internal_organization_id uuid [null,  ref: > internal_organizations.id]
  actor_internal_organization_name text [null]
  actor_user_mail_address text [not null]
  target_type varchar(100) [not null, Note: "操作対象名"]
  target_id uuid [not null, Note: "操作対象識別子"]
  operation_type operation_type [not null, Note: "操作種別"]
  occurred_at timestamptz [not null]
}